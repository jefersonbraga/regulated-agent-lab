# Local settings for the API, CLI and compose.yaml: cp .env.example .env (repo root; .env is
# gitignored). Read by `make dev-api` / uvicorn --env-file ../.env, the CLI and docker compose.
#
# OpenAI-compatible chat endpoint of the on-prem model (LAN or VPN address, never public)
VLLM_BASE_URL=http://dgx-spark.local:8000/v1
VLLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_TOKEN_SECRET=change-me
# Runtime data. Relative paths resolve against the API's working directory, backend/ (make
# dev-api, `cd backend && uv run uvicorn ...`), i.e. backend/var/; unset, the code uses the same
# backend/var/ defaults. In Docker they are /app/var/... (set by the image and compose files).
AUDIT_LOG_PATH=var/audit.jsonl
# SQLite: LangGraph checkpoints (paused runs survive a restart) and run history (GET /runs)
LAB_DB_PATH=var/lab.db
# SQLite of the payments institution: its own file, never the agents' DB (idempotency ledger)
PAYMENTS_DB_PATH=var/payments.db
# SQLite of the wallet institution: saved-card references (processor ids, brand, last four,
# expiry; never a card number), spending limits and single-use payment tokens (hashes only)
WALLET_DB_PATH=var/wallet.db
# Deadline in seconds for each MCP tool request (stalled server -> tool_error)
MCP_CALL_TIMEOUT_S=10
# Optional real parts (both default to simulated):
# real direct trains from a public timetable API; fares and seat holds stay simulated
TRAVEL_SEARCH_SOURCE=simulated
# simulated | stripe_test: card processor in TEST MODE (sk_test_ or rk_test_ keys only, never moves money)
PAYMENTS_PROVIDER=simulated
STRIPE_TEST_SECRET_KEY=
# Endpoint secret (whsec_...) for POST /webhooks/stripe, printed by `stripe listen` or shown on
# the dashboard's webhook endpoint. Unset: the endpoint answers 503 and stores nothing.
STRIPE_WEBHOOK_SECRET=
# Which payment models an approver may choose with stripe_test (the simulated provider is always
# a simulated capture):
#   both (default)  the approval card offers both, proposing the wallet when it can pay
#   checkout        the customer pays on the processor's hosted Checkout page
#   wallet          the agent pays from the user's wallet with a scoped single-use token (falls
#                   back to checkout when the bank asks for authentication, the total is above
#                   the user's limit or no card is saved). "agent" is a legacy alias of wallet.
PAYMENTS_FLOW=both
# Where the processor sends the customer back after Checkout or the wallet's card form (the UI).
PUBLIC_APP_URL=http://localhost:5173

# --- API authentication (required: the API refuses to start without both) ---------------------
# One entry per user from `cd backend && uv run ral-hash-password <name> [--role approver]`,
# comma-separated, in SINGLE quotes (the hashes contain $). Roles: requester | approver | both.
DEMO_USERS='alice:scrypt$<salt_hex>$<hash_hex>,bob:approver:scrypt$<salt_hex>$<hash_hex>'
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# 1 behind HTTPS (required when published): the session cookie is then sent over HTTPS only.
COOKIE_SECURE=0
# 1: the user who created a run cannot approve it (segregation of duties).
REQUIRE_SEPARATE_APPROVER=0
# Extra exact UI origins allowed by CORS and the Origin check, comma-separated (e.g. the public UI).
API_EXTRA_CORS_ORIGINS=
# Local development only: no login, no Origin check, no rate limits (a warning is logged).
# API_AUTH_DISABLED=1
