# Production settings for deploy/docker-compose.prod.yml. PLACEHOLDERS ONLY.
#
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
#
# deploy/.env.prod is gitignored and holds the real secrets: never commit it, never paste it.
# It is read twice: by `docker compose --env-file` (DOMAIN, CADDY_IP, DEPLOY_SUBNET for the
# compose file and the Caddyfile) and as the API container's environment (everything else).
# Values in single quotes are taken literally (needed for DEMO_USERS: the hashes contain $).

# --- Domain and URLs -------------------------------------------------------------------------
# The public host name only, no scheme. Its DNS A record must point at the VM's public IP.
# Free options: a DuckDNS subdomain (lab-demo.duckdns.org) or <ip>.sslip.io (203-0-113-10.sslip.io).
DOMAIN=lab-demo.example.org
# https://DOMAIN, no trailing slash: where the processor sends customers back after Checkout or
# the wallet's card form. Its origin is also allowed by the API's CORS and Origin check.
PUBLIC_APP_URL=https://lab-demo.example.org
# Extra exact origins allowed by CORS / the Origin check (comma-separated). Not needed for the
# single-domain setup: PUBLIC_APP_URL's origin is already allowed.
API_EXTRA_CORS_ORIGINS=

# --- Authentication (the API refuses to start without DEMO_USERS and SESSION_SECRET) ----------
# Always 1 here (the compose file enforces it too): session cookie Secure, HSTS from the API.
COOKIE_SECURE=1
# At least 32 random characters:  openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# One entry per user, comma-separated, in SINGLE quotes. Generate each with (passwords are typed
# twice without echo, never printed):
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod \
#     run --rm --no-deps api python scripts/hash_password.py alice --role requester
# Roles: requester | approver | both (default).
DEMO_USERS='alice:requester:scrypt$<salt_hex>$<hash_hex>,bob:approver:scrypt$<salt_hex>$<hash_hex>'
# 1: whoever created a run cannot approve it (segregation of duties; needs two accounts).
REQUIRE_SEPARATE_APPROVER=1

# --- Agents ------------------------------------------------------------------------------------
# Signs the single-use approval tokens. Random, and keep it stable: paused runs need the same one.
#   openssl rand -hex 32
AGENT_TOKEN_SECRET=replace-with-a-long-random-value
# anthropic | openai | mock. NOT vllm: the on-prem vLLM on the LAN is not reachable from a public
# VM (and must never be exposed to the internet). mock answers from fixtures, offline, free.
LLM_PROVIDER=mock
# Model id for the cloud provider (overrides config/llm.yaml, whose model is the vLLM one).
# e.g. claude-sonnet-5-5 for anthropic, or an OpenAI model id. Ignored by mock.
LLM_MODEL=
# Only the key of the provider you use. Set a spending limit at the provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Deadline in seconds for each MCP tool request.
MCP_CALL_TIMEOUT_S=10

# --- Travel search -------------------------------------------------------------------------------
# live: real direct trains from a public timetable API (fares and seat holds stay simulated).
# simulated: the built-in fictional timetable, no network.
TRAVEL_SEARCH_SOURCE=live

# --- Payments (TEST MODE ONLY: sk_test_/rk_test_ keys; never moves money) ------------------------
# stripe_test | simulated
PAYMENTS_PROVIDER=stripe_test
# both | checkout | wallet (see the main README, "Two payment models").
PAYMENTS_FLOW=both
# Prefer a restricted rk_test_ key (Checkout Sessions, PaymentIntents; for the wallet also
# Customers, SetupIntents, PaymentMethods).
STRIPE_TEST_SECRET_KEY=rk_test_replace_me
# Signing secret (whsec_...) of the endpoint https://DOMAIN/api/webhooks/stripe (deploy/README.md).
# Unset: the webhook endpoint answers 503 and stores nothing.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Persistence (inside the API container; /app/var is the lab_var volume) ----------------------
AUDIT_LOG_PATH=/app/var/audit.jsonl
LAB_DB_PATH=/app/var/lab.db
PAYMENTS_DB_PATH=/app/var/payments.db
WALLET_DB_PATH=/app/var/wallet.db

# --- Network (defaults are fine; change both together if the subnet clashes on the VM) -----------
# uvicorn trusts X-Forwarded-For only from CADDY_IP, so login rate limits see real client IPs.
DEPLOY_SUBNET=172.30.250.0/24
CADDY_IP=172.30.250.10
